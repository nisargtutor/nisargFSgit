<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Investment Appraisal Simulation — IB DP Business Management</title>
<link href="https://fonts.googleapis.com/css2?family=Fredoka+One&family=Nunito:wght@400;600;700;800&family=Space+Mono:wght@400;700&display=swap" rel="stylesheet">
<style>
:root {
  --primary: #6c3ce2;
  --primary-light: #9b6ff5;
  --accent: #ff6b35;
  --accent2: #00c9a7;
  --accent3: #ffd166;
  --bg: #f0eeff;
  --card: #ffffff;
  --text: #1a1240;
  --text-muted: #6b7280;
  --green: #16a34a;
  --amber: #d97706;
  --red: #dc2626;
  --bar-green: #22c55e;
  --bar-amber: #f59e0b;
  --bar-red: #ef4444;
  --radius: 20px;
  --shadow: 0 8px 32px rgba(108,60,226,0.12);
}
* { box-sizing: border-box; margin: 0; padding: 0; }
body {
  font-family: 'Nunito', sans-serif;
  background: var(--bg);
  color: var(--text);
  min-height: 100vh;
  overflow-x: hidden;
}

/* ─── SPLASH ─── */
#splash {
  position: fixed; inset: 0; z-index: 9999;
  background: linear-gradient(135deg, #1a0533 0%, #3d1080 40%, #6c3ce2 80%, #ff6b35 100%);
  display: flex; flex-direction: column; align-items: center; justify-content: center;
  gap: 18px; transition: opacity 0.6s;
}
#splash h1 {
  font-family: 'Fredoka One', cursive;
  font-size: clamp(2rem, 5vw, 3.6rem);
  color: #fff;
  text-align: center;
  line-height: 1.15;
  text-shadow: 0 4px 24px rgba(0,0,0,0.4);
  max-width: 700px;
}
#splash .sub {
  font-size: 1.05rem;
  color: rgba(255,255,255,0.82);
  font-weight: 700;
  letter-spacing: 1px;
  text-align: center;
}
#splash .badge-row {
  display: flex; gap: 10px; flex-wrap: wrap; justify-content: center; margin-top: 6px;
}
#splash .badge {
  background: rgba(255,255,255,0.15);
  border: 1.5px solid rgba(255,255,255,0.35);
  color: #fff;
  border-radius: 50px;
  padding: 5px 16px;
  font-size: 0.82rem;
  font-weight: 700;
  letter-spacing: 0.5px;
}
#startBtn {
  margin-top: 14px;
  padding: 16px 52px;
  font-family: 'Fredoka One', cursive;
  font-size: 1.45rem;
  background: linear-gradient(135deg, #ff6b35, #ffd166);
  color: #1a0533;
  border: none; border-radius: 50px;
  cursor: pointer;
  box-shadow: 0 8px 32px rgba(255,107,53,0.45);
  animation: pulse-btn 2s infinite;
  transition: transform 0.15s;
}
#startBtn:hover { transform: scale(1.06); }
@keyframes pulse-btn {
  0%,100% { box-shadow: 0 8px 32px rgba(255,107,53,0.45); }
  50% { box-shadow: 0 8px 48px rgba(255,107,53,0.75); }
}
.splash-stars {
  position: absolute; inset: 0; pointer-events: none; overflow: hidden;
}
.star {
  position: absolute; border-radius: 50%;
  background: rgba(255,255,255,0.7);
  animation: twinkle var(--d,3s) ease-in-out infinite;
}
@keyframes twinkle {
  0%,100%{opacity:.2;transform:scale(1)}
  50%{opacity:1;transform:scale(1.4)}
}

/* ─── MAIN LAYOUT ─── */
#app { display: none; flex-direction: column; min-height: 100vh; }

/* ─── TOPBAR ─── */
#topbar {
  background: linear-gradient(90deg, #1a0533 0%, #3d1080 100%);
  padding: 10px 24px;
  display: flex; align-items: center; justify-content: space-between;
  position: sticky; top: 0; z-index: 100;
  box-shadow: 0 2px 16px rgba(0,0,0,0.25);
}
#topbar h2 {
  font-family: 'Fredoka One', cursive;
  color: #fff; font-size: 1.3rem;
}
#resetBtn {
  background: #ff6b35; color: #fff;
  border: none; border-radius: 50px;
  padding: 7px 20px; font-family: 'Nunito', sans-serif;
  font-weight: 800; font-size: 0.9rem;
  cursor: pointer; transition: background 0.2s, transform 0.15s;
}
#resetBtn:hover { background: #e55a22; transform: scale(1.05); }

/* ─── PHASE TIMELINE ─── */
#timeline {
  display: flex; align-items: center; justify-content: center;
  gap: 0; padding: 18px 24px 10px;
}
.phase-node {
  display: flex; flex-direction: column; align-items: center; gap: 4px;
  position: relative;
}
.phase-circle {
  width: 44px; height: 44px; border-radius: 50%;
  background: #e0d8ff;
  border: 3px solid #c4b5fd;
  display: flex; align-items: center; justify-content: center;
  font-family: 'Fredoka One', cursive;
  font-size: 1.1rem; color: #7c3aed;
  transition: all 0.4s;
}
.phase-circle.active {
  background: var(--primary); color: #fff;
  border-color: var(--primary-light);
  box-shadow: 0 0 0 6px rgba(108,60,226,0.2);
  animation: phase-pulse 1.5s infinite;
}
.phase-circle.done {
  background: var(--accent2); color: #fff;
  border-color: #00a98f;
}
@keyframes phase-pulse {
  0%,100%{box-shadow:0 0 0 6px rgba(108,60,226,0.2)}
  50%{box-shadow:0 0 0 12px rgba(108,60,226,0.08)}
}
.phase-label {
  font-size: 0.72rem; font-weight: 700;
  color: var(--text-muted);
  text-align: center;
  max-width: 80px;
}
.phase-label.active { color: var(--primary); }
.phase-connector {
  width: 60px; height: 3px;
  background: #c4b5fd;
  margin: 0; align-self: center; margin-bottom: 22px;
  transition: background 0.4s;
}
.phase-connector.done { background: var(--accent2); }

/* ─── MAIN GRID ─── */
#maingrid {
  display: grid;
  grid-template-columns: 340px 1fr 260px;
  gap: 16px;
  padding: 0 16px 16px;
  flex: 1;
}
@media(max-width:900px){
  #maingrid { grid-template-columns: 1fr; }
}

/* ─── CARDS ─── */
.card {
  background: var(--card);
  border-radius: var(--radius);
  box-shadow: var(--shadow);
  padding: 18px;
  border: 1.5px solid rgba(108,60,226,0.08);
}
.card-title {
  font-family: 'Fredoka One', cursive;
  font-size: 1.05rem; color: var(--primary);
  margin-bottom: 12px;
  display: flex; align-items: center; gap: 8px;
}

/* ─── SLIDERS ─── */
.slider-row { margin-bottom: 14px; }
.slider-label {
  font-size: 0.82rem; font-weight: 700; color: var(--text);
  margin-bottom: 4px; display: flex; justify-content: space-between;
}
.slider-val {
  font-family: 'Space Mono', monospace;
  font-size: 0.78rem; color: var(--primary);
  background: #ede9fe; padding: 2px 8px; border-radius: 20px;
}
input[type=range] {
  width: 100%; accent-color: var(--primary);
  height: 6px; border-radius: 20px; cursor: pointer;
}

/* ─── SVG SCENE ─── */
#sceneContainer {
  border-radius: var(--radius);
  overflow: hidden;
  background: linear-gradient(180deg, #c3e6ff 0%, #e8f4fd 60%, #a8e6cf 100%);
  min-height: 280px;
  position: relative;
  box-shadow: var(--shadow);
  border: 1.5px solid rgba(108,60,226,0.08);
}
#mainSvg { width: 100%; height: 100%; min-height: 280px; display: block; }

/* ─── METRICS BARS ─── */
.metric-bar-row { margin-bottom: 10px; }
.metric-bar-label {
  font-size: 0.78rem; font-weight: 700;
  display: flex; justify-content: space-between; margin-bottom: 3px;
}
.metric-bar-track {
  height: 14px; background: #ede9fe;
  border-radius: 20px; overflow: hidden;
}
.metric-bar-fill {
  height: 100%; border-radius: 20px;
  transition: width 0.7s cubic-bezier(.4,0,.2,1), background 0.7s;
}
.warn-blink { animation: blink-warn 0.6s infinite; }
@keyframes blink-warn {
  0%,100%{opacity:1} 50%{opacity:0.3}
}

/* ─── PREDICTION WIDGET ─── */
.pred-options {
  display: grid; grid-template-columns: 1fr 1fr; gap: 8px; margin-bottom: 12px;
}
.pred-btn {
  padding: 10px 6px; border-radius: 14px;
  border: 2.5px solid #e0d8ff;
  background: #f5f3ff; cursor: pointer;
  font-family: 'Nunito', sans-serif; font-weight: 800; font-size: 0.85rem;
  color: var(--text); transition: all 0.2s;
  text-align: center;
}
.pred-btn:hover { border-color: var(--primary); background: #ede9fe; }
.pred-btn.selected {
  border-color: var(--primary);
  background: var(--primary); color: #fff;
  box-shadow: 0 4px 16px rgba(108,60,226,0.3);
}

#advanceBtn {
  width: 100%; padding: 13px;
  font-family: 'Fredoka One', cursive; font-size: 1.15rem;
  border: none; border-radius: 14px;
  background: linear-gradient(135deg, var(--primary), var(--primary-light));
  color: #fff; cursor: pointer;
  transition: all 0.2s;
  box-shadow: 0 4px 16px rgba(108,60,226,0.3);
}
#advanceBtn:disabled {
  background: #d1d5db; color: #9ca3af;
  box-shadow: none; cursor: not-allowed;
}
#advanceBtn:not(:disabled):hover {
  transform: translateY(-2px);
  box-shadow: 0 8px 24px rgba(108,60,226,0.4);
}

/* ─── CHART ─── */
#chartCanvas { width: 100%; border-radius: 12px; }

/* ─── ADVISOR CHIPS ─── */
.advisor-row { display: flex; gap: 8px; flex-wrap: wrap; margin-top: 8px; }
.advisor-chip {
  display: flex; align-items: center; gap: 6px;
  background: #f5f3ff; border: 2px solid #e0d8ff;
  border-radius: 50px; padding: 6px 14px;
  font-size: 0.78rem; font-weight: 700;
  cursor: pointer; transition: all 0.2s;
  position: relative;
}
.advisor-chip:hover { border-color: var(--primary); background: #ede9fe; }
.advisor-chip .tooltip {
  display: none; position: absolute; bottom: 110%; left: 50%; transform: translateX(-50%);
  background: #1a0533; color: #fff; padding: 8px 12px; border-radius: 10px;
  font-size: 0.75rem; font-weight: 600; white-space: nowrap; z-index: 50;
  box-shadow: 0 4px 16px rgba(0,0,0,0.25);
  max-width: 220px; white-space: normal; text-align: center;
}
.advisor-chip:hover .tooltip { display: block; }

/* ─── ATL TRACKER ─── */
#atlTracker {
  background: linear-gradient(135deg, #1a0533, #3d1080);
  border-radius: var(--radius); padding: 14px;
  color: #fff;
}
#atlTracker .atl-title {
  font-family: 'Fredoka One', cursive; font-size: 0.95rem;
  color: var(--accent3); margin-bottom: 8px;
}
.atl-item { font-size: 0.75rem; margin-bottom: 5px; display: flex; align-items: center; gap: 6px; }
.atl-dot {
  width: 10px; height: 10px; border-radius: 50%; flex-shrink: 0;
  background: #555;
  transition: background 0.4s;
}
.atl-dot.active { background: var(--accent2); box-shadow: 0 0 6px var(--accent2); }

/* ─── MODAL ─── */
#modalOverlay {
  display: none; position: fixed; inset: 0; z-index: 500;
  background: rgba(26,2,51,0.7); backdrop-filter: blur(4px);
  align-items: center; justify-content: center;
  padding: 16px;
}
#modalOverlay.show { display: flex; }
#modal {
  background: #fff; border-radius: 24px;
  max-width: 680px; width: 100%;
  box-shadow: 0 24px 80px rgba(108,60,226,0.3);
  overflow: hidden; animation: modal-in 0.35s cubic-bezier(.4,0,.2,1);
  max-height: 90vh; overflow-y: auto;
}
@keyframes modal-in {
  from{opacity:0;transform:scale(0.9) translateY(20px)}
  to{opacity:1;transform:scale(1) translateY(0)}
}
.modal-header {
  background: linear-gradient(135deg, var(--primary), #9b6ff5);
  padding: 20px 24px 16px; color: #fff;
}
.modal-header h3 {
  font-family: 'Fredoka One', cursive; font-size: 1.5rem;
}
.modal-body { padding: 20px 24px; }

/* ─── OUTCOME GRID ─── */
.outcome-grid {
  display: grid; grid-template-columns: repeat(3,1fr); gap: 10px; margin-bottom: 16px;
}
.outcome-cell {
  background: #f5f3ff; border-radius: 14px;
  padding: 12px 10px; text-align: center;
  border: 2px solid #e0d8ff;
}
.outcome-cell .oc-label { font-size: 0.72rem; font-weight: 700; color: var(--text-muted); }
.outcome-cell .oc-val {
  font-family: 'Space Mono', monospace;
  font-size: 1.05rem; font-weight: 700; color: var(--primary);
  margin: 4px 0;
}
.outcome-cell .oc-arrow { font-size: 1.2rem; }
.arrow-up { color: var(--green); }
.arrow-down { color: var(--red); }

/* ─── CAUSE CHAIN ─── */
.cause-chain {
  display: flex; align-items: center; gap: 6px;
  flex-wrap: wrap; margin-bottom: 14px;
  padding: 12px; background: #f0fdf4; border-radius: 14px;
  border: 1.5px solid #86efac;
}
.cause-node {
  background: #fff; border: 2px solid #bbf7d0;
  border-radius: 10px; padding: 6px 12px;
  font-size: 0.78rem; font-weight: 700; color: #166534;
}
.cause-arrow { font-size: 1.1rem; color: #16a34a; }

/* ─── THREE FUTURES ─── */
.futures-section { margin-bottom: 16px; }
.futures-section h4 {
  font-family: 'Fredoka One', cursive; color: var(--primary);
  font-size: 1rem; margin-bottom: 10px;
}
.futures-grid { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 8px; }
.future-card {
  border-radius: 14px; padding: 12px; font-size: 0.77rem;
  border: 2px solid; font-weight: 600;
}
.future-A { background: #f0fdf4; border-color: #86efac; color: #166534; }
.future-B { background: #fffbeb; border-color: #fcd34d; color: #92400e; }
.future-C { background: #fef2f2; border-color: #fca5a5; color: #991b1b; }
.future-card .future-label {
  font-family: 'Fredoka One', cursive; font-size: 0.9rem; margin-bottom: 4px;
}

.rank-section { margin-bottom: 14px; }
.rank-section label {
  font-size: 0.78rem; font-weight: 700; color: var(--text-muted);
  display: block; margin-bottom: 6px;
}
.rank-options { display: flex; gap: 6px; flex-wrap: wrap; }
.rank-btn {
  padding: 6px 14px; border-radius: 50px;
  border: 2px solid #e0d8ff;
  background: #f5f3ff;
  font-family: 'Nunito', sans-serif; font-weight: 800; font-size: 0.8rem;
  cursor: pointer; transition: all 0.2s;
}
.rank-btn.selected { background: var(--primary); color: #fff; border-color: var(--primary); }

.justify-input {
  width: 100%; border: 2px solid #e0d8ff;
  border-radius: 12px; padding: 9px 12px;
  font-family: 'Nunito', sans-serif; font-size: 0.85rem;
  resize: vertical; min-height: 54px; outline: none;
  transition: border-color 0.2s;
}
.justify-input:focus { border-color: var(--primary); }

/* ─── REAL WORLD ECHO ─── */
.rw-echo {
  background: linear-gradient(135deg, #1a0533, #3d1080);
  border-radius: 14px; padding: 14px; margin-bottom: 14px;
  color: #fff;
}
.rw-echo .rw-title {
  font-family: 'Fredoka One', cursive; color: var(--accent3);
  font-size: 0.9rem; margin-bottom: 6px;
}
.rw-echo p { font-size: 0.8rem; line-height: 1.5; color: rgba(255,255,255,0.9); }

/* ─── LP CHIPS ─── */
.lp-chips { display: flex; gap: 8px; flex-wrap: wrap; margin-bottom: 12px; }
.lp-chip {
  padding: 7px 16px; border-radius: 50px;
  border: 2px solid #e0d8ff;
  font-family: 'Nunito', sans-serif; font-weight: 800; font-size: 0.8rem;
  cursor: pointer; background: #f5f3ff; transition: all 0.2s;
}
.lp-chip.selected { background: var(--accent); color: #fff; border-color: var(--accent); }

/* ─── EVENT CARD ─── */
.event-card {
  background: linear-gradient(135deg, #ff6b35, #ffd166);
  border-radius: 14px; padding: 14px; margin-bottom: 14px; color: #1a0533;
}
.event-card .ev-title {
  font-family: 'Fredoka One', cursive; font-size: 1rem; margin-bottom: 4px;
}
.event-card p { font-size: 0.82rem; font-weight: 600; }

/* ─── CONFIRM REVEAL BTN ─── */
.reveal-btn {
  background: linear-gradient(135deg, var(--accent), var(--accent3));
  color: #1a0533; border: none; border-radius: 14px;
  padding: 12px 28px; font-family: 'Fredoka One', cursive;
  font-size: 1.05rem; cursor: pointer; margin-right: 8px;
  transition: transform 0.15s;
}
.reveal-btn:hover { transform: scale(1.04); }
.close-modal-btn {
  background: #e0d8ff; color: var(--primary); border: none;
  border-radius: 14px; padding: 12px 24px;
  font-family: 'Fredoka One', cursive; font-size: 1rem;
  cursor: pointer; transition: background 0.2s;
}
.close-modal-btn:hover { background: #c4b5fd; }

/* ─── REFLECTION PANEL ─── */
#reflectionPanel {
  display: none;
  background: linear-gradient(135deg, #1a0533 0%, #3d1080 100%);
  border-radius: var(--radius); padding: 24px; margin: 0 16px 16px; color: #fff;
}
#reflectionPanel h3 {
  font-family: 'Fredoka One', cursive; font-size: 1.4rem;
  color: var(--accent3); margin-bottom: 16px; text-align: center;
}
.reflect-q {
  background: rgba(255,255,255,0.08);
  border-radius: 14px; padding: 14px; margin-bottom: 10px;
  border-left: 4px solid var(--accent);
}
.reflect-q .q-num {
  font-family: 'Fredoka One', cursive; color: var(--accent);
  font-size: 0.85rem; margin-bottom: 4px;
}
.reflect-q p { font-size: 0.85rem; line-height: 1.55; color: rgba(255,255,255,0.9); }

/* ─── TOAST ─── */
#toastContainer {
  position: fixed; bottom: 24px; right: 24px;
  z-index: 9000; display: flex; flex-direction: column; gap: 8px;
}
.toast {
  background: #1a0533; color: #fff;
  padding: 12px 20px; border-radius: 14px;
  font-size: 0.85rem; font-weight: 700;
  box-shadow: 0 8px 24px rgba(0,0,0,0.3);
  animation: toast-in 0.3s ease-out, toast-out 0.3s ease-in 3.5s forwards;
  border-left: 4px solid var(--accent2);
}
@keyframes toast-in { from{opacity:0;transform:translateX(40px)} to{opacity:1;transform:translateX(0)} }
@keyframes toast-out { to{opacity:0;transform:translateX(40px)} }

/* ─── ROUND BADGE ─── */
.round-badge {
  background: var(--accent); color: #fff;
  padding: 3px 12px; border-radius: 50px;
  font-size: 0.72rem; font-weight: 800;
  display: inline-block; margin-left: 6px;
}

/* ─── RESULTS HISTORY ─── */
.history-row {
  display: flex; gap: 6px; align-items: center;
  font-size: 0.75rem; padding: 6px 8px;
  background: #f5f3ff; border-radius: 10px; margin-bottom: 5px;
}
.history-row .h-round {
  background: var(--primary); color: #fff;
  border-radius: 50%; width: 22px; height: 22px;
  display: flex; align-items: center; justify-content: center;
  font-family: 'Fredoka One', cursive; font-size: 0.8rem; flex-shrink: 0;
}

/* ─── SVG ANIMATIONS ─── */
.svg-cloud { animation: float-cloud 8s ease-in-out infinite; }
.svg-cloud2 { animation: float-cloud 11s ease-in-out infinite reverse; }
@keyframes float-cloud {
  0%,100%{transform:translateX(0)} 50%{transform:translateX(18px)}
}
.svg-coin { animation: spin-coin 2s linear infinite; }
@keyframes spin-coin {
  0%{transform:rotateY(0deg)} 100%{transform:rotateY(360deg)}
}
.factory-smoke { animation: smoke-rise 2s ease-in-out infinite; }
@keyframes smoke-rise {
  0%{opacity:0.8;transform:translateY(0) scale(0.8)}
  100%{opacity:0;transform:translateY(-30px) scale(1.5)}
}
</style>
</head>
<body>

<!-- ─── SPLASH ─── -->
<div id="splash">
  <div class="splash-stars" id="starsContainer"></div>
  <h1>💰 Investment Appraisal<br>Simulation</h1>
  <div class="sub">Payback Period · NPV · ARR</div>
  <div class="badge-row">
    <span class="badge">📚 IB DP Business Management</span>
    <span class="badge">🎓 Year 11</span>
    <span class="badge">🔑 Key Concept: Decision-Making</span>
    <span class="badge">🧠 ATL: Thinking & Research</span>
  </div>
  <button id="startBtn">🚀 Start Simulation</button>
</div>

<!-- ─── TOAST CONTAINER ─── -->
<div id="toastContainer"></div>

<!-- ─── MODAL ─── -->
<div id="modalOverlay">
  <div id="modal">
    <div class="modal-header">
      <h3 id="modalTitle">Round Results</h3>
      <div style="font-size:0.85rem;opacity:0.85;margin-top:4px;" id="modalRoundLabel"></div>
    </div>
    <div class="modal-body" id="modalBody"></div>
  </div>
</div>

<!-- ─── APP ─── -->
<div id="app">

  <!-- TOPBAR -->
  <div id="topbar">
    <h2>💹 Investment Appraisal — IB DP BM</h2>
    <div style="display:flex;gap:10px;align-items:center;">
      <span id="topRound" style="color:#ffd166;font-weight:800;font-size:0.9rem;">Round 1 of 3</span>
      <button id="resetBtn">🔄 Reset</button>
    </div>
  </div>

  <!-- PHASE TIMELINE -->
  <div id="timeline">
    <div class="phase-node">
      <div class="phase-circle active" id="pc1">1</div>
      <div class="phase-label active" id="pl1">Small-Scale<br>Investment</div>
    </div>
    <div class="phase-connector" id="conn1"></div>
    <div class="phase-node">
