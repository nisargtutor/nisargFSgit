// ─── THREE FUTURES ───
function getThreeFutures(m, sc) {
  const npvK = (m.npv/1000).toFixed(0);
  const payback = m.payback > m.life ? `more than ${m.life}` : m.payback.toFixed(1);
  const accept = m.accept;

  return {
    A: `The project generates positive NPV of £${Math.abs(npvK)}K+ with a payback of under ${Math.ceil(m.life*0.5)} years. ARR exceeds 15%, the board approves, and the business expands confidently.`,
    B: `The project ${accept ? 'is accepted' : 'is rejected'} with NPV of £${npvK}K and a payback of ${payback} years. ARR is ${m.arr.toFixed(1)}%, ${m.arr > 10 ? 'meeting' : 'missing'} the hurdle rate. The decision ${accept ? 'proceeds cautiously' : 'is deferred pending review'}.`,
    C: `Rising discount rates collapse the NPV to deeply negative. Payback exceeds the project life — investment is never recovered. The board rejects the project and the company misses the market opportunity.`
  };
}

// ─── DETERMINE ACTUAL FUTURE ───
function actualFuture(sc) {
  const avg = (sc.npv + sc.arr + sc.payback) / 3;
  if (avg > 62) return 'A';
  if (avg > 35) return 'B';
  return 'C';
}

// ─── CAUSE CHAIN ───
function getCauseChain(m, sc) {
  if (m.accept) {
    return ['Annual CFs > Discount cost','NPV turns positive','ARR meets hurdle','Board ACCEPTS'];
  } else if (m.payback > m.life) {
    return ['Payback > Project life','Investment never recovered','NPV deeply negative','Board REJECTS'];
  } else {
    return ['High discount rate','Future CFs heavily discounted','NPV negative','Board REJECTS'];
  }
}

