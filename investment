// ─── CHART ───
let chartCtx;
function renderChart() {
  const canvas = document.getElementById('chartCanvas');
  if (!chartCtx) chartCtx = canvas.getContext('2d');
  const W = canvas.offsetWidth || 400;
  const H = 140;
  canvas.width = W * window.devicePixelRatio;
  canvas.height = H * window.devicePixelRatio;
  canvas.style.width = W + 'px';
  canvas.style.height = H + 'px';
  const ctx = chartCtx;
  ctx.scale(window.devicePixelRatio, window.devicePixelRatio);
  ctx.clearRect(0,0,W,H);

  // Background
  ctx.fillStyle = '#f5f3ff';
  ctx.roundRect(0,0,W,H,12);
  ctx.fill();

  // Grid
  ctx.strokeStyle = '#e0d8ff'; ctx.lineWidth = 1;
  [25,50,75].forEach(pct => {
    const y = H - (pct/100)*H*0.85 - 10;
    ctx.beginPath(); ctx.moveTo(30,y); ctx.lineTo(W-10,y); ctx.stroke();
    ctx.fillStyle='#c4b5fd'; ctx.font='9px Space Mono'; ctx.fillText(pct+'%',2,y+3);
  });

  const data = state.chartData;
  const allData = [...data.payback, ...data.arr, ...data.npv];
  if (allData.length === 0) {
    ctx.fillStyle='#9ca3af'; ctx.font='12px Nunito'; ctx.textAlign='center';
    ctx.fillText('Complete rounds to see tracking data', W/2, H/2);
    return;
  }

  const series = [
    { data: data.payback, color:'#6c3ce2', label:'Payback' },
    { data: data.arr, color:'#16a34a', label:'ARR' },
    { data: data.npv, color:'#ff6b35', label:'NPV' }
  ];

  series.forEach(s => {
    if(s.data.length < 1) return;
    ctx.beginPath();
    ctx.strokeStyle = s.color; ctx.lineWidth = 3;
    s.data.forEach((v,i) => {
      const x = 30 + (i / Math.max(2, state.maxRounds-1)) * (W-40);
      const y = H - (v/100)*(H*0.85) - 10;
      if(i===0) ctx.moveTo(x,y); else ctx.lineTo(x,y);
    });
    ctx.stroke();
    // Dots
    s.data.forEach((v,i) => {
      const x = 30 + (i / Math.max(2, state.maxRounds-1)) * (W-40);
      const y = H - (v/100)*(H*0.85) - 10;
      ctx.beginPath(); ctx.arc(x,y,5,0,Math.PI*2);
      ctx.fillStyle=s.color; ctx.fill();
    });
  });

  // Legend
  let lx = 30;
  series.forEach(s => {
    ctx.fillStyle=s.color; ctx.fillRect(lx,5,12,8);
    ctx.fillStyle='#374151'; ctx.font='9px Nunito'; ctx.textAlign='left';
    ctx.fillText(s.label, lx+16, 13);
    lx += ctx.measureText(s.label).width + 28;
  });
}

