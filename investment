<script>
// ─── STATE ───
const state = {
  round: 1,
  maxRounds: 3,
  sliders: [2, 2, 1, 2],
  prediction: null,
  history: [],
  atlBits: [false,false,false,false,false,false],
  eventFired: [false,false,false],
  chartData: { payback:[], arr:[], npv:[] }
};

// ─── CONFIG ───
const investmentMap = [100000, 500000, 1000000, 3000000, 10000000];
const cashFlowMap   = [0.05, 0.10, 0.18, 0.28, 0.40]; // fraction of investment per year
const discountMap   = [0.03, 0.05, 0.08, 0.12, 0.15];
const lifeMap       = [3, 5, 8, 10, 15];
const investLabels  = ['£100K','£500K','£1M','£3M','£10M'];
const flowLabels    = ['Very Low','Low','Moderate','High','Very High'];
const discLabels    = ['3%','5%','8%','12%','15%'];
const lifeLabels    = ['3 yrs','5 yrs','8 yrs','10 yrs','15 yrs'];

const guidingQs = [
  "🤔 Round 1: You are advising a small business on a solar panel installation. Which variable do you think will have the biggest impact on the payback period?",
  "🤔 Round 2: You are advising an NHS Trust on a new MRI machine. With more cash flow data available, how does risk change your discount rate choice?",
  "🤔 Round 3: You are evaluating the HS2 railway project. With billions at stake, which single metric — Payback, ARR, or NPV — would you rely on most? Why?"
];

const realWorldEchos = [
  { title: "☀️ Real-World Echo — Solar Panels", text: "UK households installing solar panels in 2024 faced payback periods of 8–12 years with no government subsidy. A 3% discount rate (close to mortgage rates) made the NPV positive. Many households rejected the investment despite positive long-run returns — confirming that payback period shapes real behaviour." },
  { title: "🏥 Real-World Echo — NHS MRI Machines", text: "NHS Trusts use a 3.5% Treasury discount rate for capital investments. A new MRI machine costing £1.2M might generate £180K in annual efficiency savings. With a 10-year life, NPV at 3.5% is strongly positive — but budget constraints mean payback period often overrides NPV in NHS decisions." },
  { title: "🚄 Real-World Echo — HS2 Railway", text: "HS2 Phase 1 had an original BCR (Benefit-Cost Ratio) of 2.3 — meaning £2.30 returned per £1 spent. However, revised cost estimates pushed the BCR below 1.5 as the discount rate applied to future benefits eroded NPV significantly. In 2023, Phase 2 was cancelled — a real-world NPV rejection decision." }
];

const events = [
  { round: 1, title: "⚡ Unexpected Event: Interest Rate Rise!", text: "The Bank of England raises rates by 1.5%. Your discount rate effectively increases. NPV falls — but your short payback period provides protection!", effect: { disc: 1 } },
  { round: 2, title: "🌱 Unexpected Event: Green Energy Grant!", text: "Government announces a £50K sustainability grant! Your initial investment outlay is effectively reduced, improving payback period and ARR.", effect: { inv: -1 } },
  { round: 3, title: "📉 Unexpected Event: Supply Chain Shock!", text: "Global supply disruption cuts annual cash flows by 15% for Year 1. Projects with high discount rates are hit hardest — resilient early decisions pay off!", effect: { flow: -1 } }
];

// ─── CALCULATIONS ───
function calcMetrics(s) {
  const inv  = investmentMap[s[0]];
  const flow = cashFlowMap[s[1]] * inv;
  const disc = discountMap[s[2]];
  const life = lifeMap[s[3]];

  // Payback Period
  let payback = inv / flow;
  if (payback > life) payback = life + 0.5; // never recovered

  // NPV
  let npv = -inv;
  for (let t = 1; t <= life; t++) {
    npv += flow / Math.pow(1 + disc, t);
  }

  // ARR
  const totalProfit = (flow * life) - inv;
  const avgAnnualProfit = totalProfit / life;
  const arr = (avgAnnualProfit / inv) * 100;

  // Accept / reject
  const accept = npv > 0;

  // Sensitivity: how much NPV drops if discount increases by 2%
  let npvSens = -inv;
  for (let t = 1; t <= life; t++) {
    npvSens += flow / Math.pow(1 + disc + 0.02, t);
  }
  const sensitivity = Math.abs((npvSens - npv) / Math.max(Math.abs(npv),1) * 100);

  return { inv, flow, disc, life, payback, npv, arr, accept, sensitivity };
}

function toScore(val, min, max, invert=false) {
  let s = Math.min(100, Math.max(0, ((val - min) / (max - min)) * 100));
  return invert ? 100 - s : s;
}

function metricsToScores(m) {
  const paybackScore = toScore(m.payback, 0, 15, true) * 0.8 + 10; // lower payback = higher score
  const npvScore = m.npv >= 0 ? toScore(m.npv, 0, 5000000) * 0.7 + 30 : toScore(m.npv, -5000000, 0) * 0.3;
  const arrScore = m.arr >= 0 ? Math.min(100, m.arr * 5) : 5;
  const acceptScore = m.accept ? 75 : 25;
  const sensScore = toScore(m.sensitivity, 0, 100, true);
  return {
    payback: Math.round(Math.min(100, Math.max(5, paybackScore))),
    npv: Math.round(Math.min(100, Math.max(2, npvScore))),
    arr: Math.round(Math.min(100, Math.max(2, arrScore))),
    accept: acceptScore,
    sensitivity: Math.round(Math.min(100, Math.max(5, sensScore)))
  };
}

