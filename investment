    pc.className = 'phase-circle';
    pl.className = 'phase-label';
    if(i < state.round){ pc.classList.add('done'); pc.textContent='✓'; }
    else if(i === state.round){ pc.classList.add('active'); pl.classList.add('active'); }
  }
  for(let i=1;i<=2;i++){
    const conn = document.getElementById('conn'+i);
    conn.className = 'phase-connector';
    if(i < state.round) conn.classList.add('done');
  }
}

// ─── HISTORY ───
function updateHistory() {
  const hp = document.getElementById('historyPanel');
  hp.innerHTML = state.history.map(h => {
    const col = h.m.accept ? '#16a34a' : '#dc2626';
    return `<div class="history-row">
      <div class="h-round">${h.round}</div>
      <div style="flex:1;">
        <div style="font-weight:700;color:${col}">${h.m.accept?'✅ ACCEPT':'❌ REJECT'}</div>
        <div style="color:var(--text-muted)">NPV: £${(h.m.npv/1000).toFixed(0)}K | ARR: ${h.m.arr.toFixed(1)}% | PB: ${h.m.payback.toFixed(1)}yr</div>
      </div>
    </div>`;
  }).join('');
}

// ─── PREDICTION CHECK ───
function checkPrediction(m, sc, pred) {
  const avg = (sc.npv + sc.arr + sc.payback) / 3;
  if(pred === 'thriving' && avg > 62 && m.accept) return true;
  if(pred === 'stable' && avg > 40 && avg <= 65) return true;
  if(pred === 'stressed' && avg > 20 && avg <= 45) return true;
  if(pred === 'crisis' && avg <= 30 && !m.accept) return true;
  return false;
}

// ─── REFLECTIONS ───
function showReflections() {
  document.getElementById('reflectionPanel').style.display = 'block';
  document.getElementById('reflectionPanel').scrollIntoView({behavior:'smooth'});
  toast('🏁 Simulation complete! Time to reflect. 🧠');
}

// ─── ATL ───
function markATL(idx) {
  if(!state.atlBits[idx]) {
    state.atlBits[idx] = true;
    document.getElementById('atl'+(idx+1)).classList.add('active');
    const count = state.atlBits.filter(Boolean).length;
    document.getElementById('atlScore').textContent = count + '/6';
  }
}

// ─── TOAST ───
function toast(msg) {
  const tc = document.getElementById('toastContainer');
  const t = document.createElement('div');
  t.className = 'toast';
  t.textContent = msg;
  tc.appendChild(t);
  setTimeout(() => t.remove(), 4200);
}

// ─── RESET ───
document.getElementById('resetBtn').addEventListener('click', () => {
  state.round = 1;
  state.sliders = [2,2,1,2];
  state.prediction = null;
  state.history = [];
  state.atlBits = [false,false,false,false,false,false];
  state.eventFired = [false,false,false];
  state.chartData = { payback:[], arr:[], npv:[] };

  sliders.forEach((sl,i) => sl.value = state.sliders[i]);
  document.querySelectorAll('.pred-btn').forEach(b=>b.classList.remove('selected'));
  document.getElementById('advanceBtn').disabled = true;
  document.getElementById('topRound').textContent = 'Round 1 of 3';
  document.querySelectorAll('.atl-dot').forEach(d=>d.classList.remove('active'));
  document.getElementById('atlScore').textContent = '0/6';
  document.getElementById('historyPanel').innerHTML = '<div style="font-size:0.78rem;color:var(--text-muted);font-weight:600;">No rounds completed yet.</div>';
  document.getElementById('reflectionPanel').style.display = 'none';
  document.getElementById('modalOverlay').classList.remove('show');

  updateTimeline();
  updateSliderLabels();
  renderMetrics();
  updateScene();
  renderChart();
  setGuidingQ();
  toast('🔄 Simulation reset! Starting from Round 1.');
});

// ─── RESIZE CHART ───
window.addEventListener('resize', renderChart);
</script>
</body>
</html>
